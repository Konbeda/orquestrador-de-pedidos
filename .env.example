# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Webhook bodies above this size are refused with 413
BODY_LIMIT=100kb

# Infra (docker compose overrides these for the app container)
MONGO_URI=mongodb://localhost:27017/orders
REDIS_HOST=localhost
REDIS_PORT=6379

# External service: Frankfurter (exchange rates, no API key)
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
FRANKFURTER_TIMEOUT_MS=3000
# Supported currencies are loaded from Frankfurter and cached; this list is used when it is down
SUPPORTED_CURRENCIES_TTL_MS=21600000
SUPPORTED_CURRENCIES_FALLBACK=USD,EUR,BRL,GBP,JPY

# Enrichment queue
ENRICHMENT_TARGET_CURRENCY=BRL
ENRICHMENT_MAX_ATTEMPTS=5
# Base delay of the exponential backoff (1s, 2s, 4s, 8s...)
ENRICHMENT_BACKOFF_MS=1000
ENRICHMENT_CONCURRENCY=5
# Waits between enqueue attempts inside the webhook request; if all fail the order is still
# accepted (202) and the sweeper enqueues it later
ENQUEUE_RETRY_DELAYS_MS=100,200,400

# Circuit breaker around Frankfurter
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MS=30000

# Reprocessing of FAILED_ENRICHMENT orders (separate, rate-limited queue)
REPROCESS_MAX_COUNT=3
REPROCESS_RATE_PER_SECOND=5

# Orphan sweeper: RECEIVED orders not checked against the queue for STALE_ORDER_AFTER_MS
# (enqueue failed and the client never retried) are enqueued again, SWEEP_BATCH_SIZE at a time
SWEEP_INTERVAL_MS=60000
STALE_ORDER_AFTER_MS=120000
SWEEP_BATCH_SIZE=100

# Same order_id with a different idempotency_key: reject (409) | update
ORDER_DUPLICATE_POLICY=reject
# With policy=update: an order accepts at most this many revisions (bounds stored keys and re-enqueues)
MAX_ORDER_REVISIONS=10

# Rejected webhook payloads (masked) are deleted after this many days
REJECTION_RETENTION_DAYS=90
